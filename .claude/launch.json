{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nuxt-landing",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "source ~/.nvm/nvm.sh && nvm use 20 && npm run dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "nuxt-prod",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "source ~/.nvm/nvm.sh && nvm use 20 && PORT=3100 node .output/server/index.mjs"],
      "port": 3100
    },
    {
      "name": "static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "."],
      "port": 3001,
      "autoPort": true
    }
  ]
}
